{
  "_notes": [
    "E2E assignment cases: one row = assign 'target' to 'source', press, check, undo.",
    "Names and target formats: PadsWayE2E/cases/README.md.",
    "Do NOT use 'home' (PS) as source or target: Windows answers a virtual Home with its own injected key.",
    "It maps like any other button, so leaving it out loses nothing."
  ],
  "cases": [
    { "source": "a",     "target": "b" },
    { "source": "start", "target": "a" },
    { "source": "b",     "target": "dpad_up" },
    { "source": "x",     "target": "r2" },
    { "source": "b",     "target": "l2" },
    { "source": "y",     "target": "right_x_neg" },
    { "source": "l3",    "target": { "type": "keyboard", "keys": ["shift", "k"] } },
    { "source": "r3",    "target": { "type": "mouse_click", "button": "middle" } },
    { "source": "l1",    "target": { "type": "macro", "execution": "X + Y=300" },
      "expect": { "plays": ["x", "y"], "minMs": 200, "maxMs": 600 } },
    { "source": "r1",    "target": { "type": "bot", "name": "TestBot" } },

    { "source": "dpad_up",    "target": "a" },
    { "source": "dpad_down",  "target": "r2" },
    { "source": "dpad_left",  "target": "dpad_right" },
    { "source": "dpad_right", "target": "left_y_pos" },
    { "source": "dpad_up",    "target": { "type": "macro", "execution": "A + B=300" },
      "expect": { "plays": ["a", "b"], "minMs": 200, "maxMs": 600 } },
    { "source": "dpad_down",  "target": { "type": "keyboard", "keys": ["ctrl", "j"] } },
    { "source": "dpad_left",  "target": { "type": "mouse_click", "button": "right" } },
    { "source": "dpad_right", "target": { "type": "bot", "name": "TestBot" } },

    { "source": "left_x_pos",  "target": "right_y_neg" },
    { "source": "left_x_neg",  "target": "x" },
    { "source": "left_y_pos",  "target": "dpad_down" },
    { "source": "left_y_neg",  "target": "l2" },
    { "source": "right_x_pos", "target": { "type": "macro", "execution": "Y + B=300" },
      "expect": { "plays": ["y", "b"], "minMs": 200, "maxMs": 600 } },
    { "source": "right_x_neg", "target": { "type": "keyboard", "keys": ["space"] } },
    { "source": "right_y_pos", "target": { "type": "mouse_click", "button": "x1" } },
    { "source": "right_y_neg", "target": { "type": "bot", "name": "TestBot" } },
    { "source": "left_x_pos",  "target": { "type": "mouse_move", "axis": "x" } },
    { "source": "right_y_neg", "target": { "type": "mouse_move", "axis": "y" } },
    { "source": "right_x_neg", "target": { "type": "mouse_move", "axis": "y" } }
  ],

  "chains": [
    [ { "source": "a",          "target": "b" },
      { "source": "b",          "target": "y" } ],
    [ { "source": "x",          "target": "y" },
      { "source": "y",          "target": "x" } ],
    [ { "source": "dpad_up",    "target": "dpad_down" },
      { "source": "dpad_down",  "target": "dpad_left" } ],
    [ { "source": "left_x_pos", "target": "right_x_pos" },
      { "source": "right_x_pos", "target": "a" } ],
    [ { "source": "a",          "target": "left_x_pos" },
      { "source": "left_x_pos", "target": "x" } ],
    [ { "source": "select",     "target": "dpad_right" },
      { "source": "dpad_right", "target": "start" } ],
    [ { "source": "dpad_left",  "target": "l1" },
      { "source": "l1",         "target": "dpad_left" } ],
    [ { "source": "left_x_pos",  "target": { "type": "mouse_move", "axis": "x" } },
      { "source": "right_x_pos", "target": "left_x_pos" } ]
  ]
}
